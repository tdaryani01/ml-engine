FROM python:3.13-slim

WORKDIR /workspace

# Native build toolchain & OpenMP runtime
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libgomp1 \
    && rm -rf /var/lib/apt/lists/*

# Slim deps for native-backend benchmark (no numba/scipy/llvmlite)
COPY requirements-docker-custom.txt .
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install -r requirements-docker-custom.txt

# Copy source repository (includes config/docker_omp.yaml)
COPY . .

# Compile native kernels
RUN mkdir -p bin && \
    sh -c 'g++ -O3 -mavx2 -mfma -fopenmp -shared -fPIC -std=c++17 \
    -D"__declspec(x)=" \
    -Wl,--allow-multiple-definition \
    $(find src/native -type f -name "*.cpp") \
    -Isrc/native \
    -o bin/conv_kernels.so'

ENV DOCKER_OMP_TARGET=custom
RUN sed -i 's/\r$//' scripts/docker_bench_entrypoint.sh && chmod +x scripts/docker_bench_entrypoint.sh

ENTRYPOINT ["/workspace/scripts/docker_bench_entrypoint.sh"]
CMD ["python", "-u", "benchmarks/run_benchmarks_docker.py"]
