FROM python:3.13-slim

WORKDIR /workspace

# Runtime OpenMP library for PyTorch CPU BLAS
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgomp1 \
    && rm -rf /var/lib/apt/lists/*

# Inline PyTorch and pipeline data ingestion stack
RUN pip install --no-cache-dir --extra-index-url https://download.pytorch.org/whl/cpu \
    torch \
    numpy \
    scipy \
    numba \
    pandas \
    joblib \
    "pyyaml>=6.0" \
    "threadpoolctl>=3.4.0"

# Python-only copy (config/data usually bind-mounted at run; kept as fallback)
COPY config/ config/
COPY src/ src/
COPY utils/ utils/
COPY benchmarks/ benchmarks/
COPY scripts/docker_bench_entrypoint.sh scripts/docker_bench_entrypoint.sh
RUN sed -i 's/\r$//' scripts/docker_bench_entrypoint.sh && chmod +x scripts/docker_bench_entrypoint.sh

ENTRYPOINT ["/workspace/scripts/docker_bench_entrypoint.sh"]
CMD ["python", "-u", "benchmarks/run_benchmarks_docker.py"]
