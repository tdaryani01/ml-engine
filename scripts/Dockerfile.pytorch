FROM python:3.13-slim

WORKDIR /workspace

# Runtime OpenMP library for PyTorch CPU BLAS
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgomp1 \
    && rm -rf /var/lib/apt/lists/*

# OpenMP tuning for Docker cpuset isolation (avoid Intel affinity fighting cgroup mask)
ENV KMP_AFFINITY=none
ENV OMP_PROC_BIND=false
ENV KMP_BLOCKTIME=5
ENV PYTHONUNBUFFERED=1

# Inline PyTorch and pipeline data ingestion stack
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --extra-index-url https://download.pytorch.org/whl/cpu \
    torch \
    numpy \
    scipy \
    numba \
    pandas \
    joblib \
    "pyyaml>=6.0" \
    "threadpoolctl>=3.4.0"

COPY . .

ENTRYPOINT ["python", "-u", "benchmarks/run_benchmarks_docker.py"]