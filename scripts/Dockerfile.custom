FROM python:3.13-slim

WORKDIR /workspace

# libgomp: avoid worker spin under Docker cpuset (4 OMP threads + main on 4 CPUs)
ENV OMP_PROC_BIND=false
ENV OMP_DYNAMIC=false
ENV OMP_MAX_ACTIVE_LEVELS=2147483647
ENV OMP_WAIT_POLICY=PASSIVE
ENV GOMP_SPINCOUNT=0
ENV PYTHONUNBUFFERED=1

# Native build toolchain & OpenMP runtime
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libgomp1 \
    && rm -rf /var/lib/apt/lists/*

# Slim deps for native-backend benchmark (no numba/scipy/llvmlite)
COPY requirements-docker-custom.txt .
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install -r requirements-docker-custom.txt

# Copy source repository
COPY . .

# Compile native kernels
RUN mkdir -p bin && \
    sh -c 'g++ -O3 -mavx2 -mfma -fopenmp -shared -fPIC -std=c++17 \
    -D"__declspec(x)=" \
    -Wl,--allow-multiple-definition \
    $(find src/native -type f -name "*.cpp") \
    -Isrc/native \
    -o bin/conv_kernels.so'

ENTRYPOINT ["python", "-u", "benchmarks/run_benchmarks_docker.py"]
